# TalentIQ local development configuration
APP_ENV=development

# Docker Compose PostgreSQL URL. For direct SQLite backend development, override DATABASE_URL.
DATABASE_URL=postgresql+psycopg://talentiq_user:local_dev_password@postgres:5432/talentiq

# Replace this placeholder with a long, unique random value in your private .env file.
# Never commit .env or share this value.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Leave blank for manual job scorecards and rules-based candidate matching.
# This key is used for job-description extraction only in the current MVP.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000

# Configuration ceiling only; uploads are synchronous and not load-tested at 500 files.
MAX_UPLOAD_FILES=500
